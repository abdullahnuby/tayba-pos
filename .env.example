# Google Apps Script Web App URL (server-side only)
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
# Must match Script Property TAYBA_API_TOKEN
GOOGLE_APPS_SCRIPT_TOKEN=replace-with-a-long-random-token
# Strong random secret for signing login sessions
AUTH_SECRET=replace-with-a-long-random-secret
